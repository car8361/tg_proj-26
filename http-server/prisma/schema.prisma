// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       BigInt @id @default(autoincrement())
  email    String @unique @db.VarChar(255)
  username String @unique @db.VarChar(64)
  password String @db.VarChar(255)

  user_email_code_reference      Email_code[]   @relation("email_codes_user_reference")
  user_relation_sender_reference Relation[]     @relation("relation_sender_id_reference")
  user_relation_target_reference Relation[]     @relation("relation_target_id_reference")
  user_chat_user_rr              Chat_user[]
  user_chat_messager_rr          Chat_message[]

  @@map("users")
}

model Email_code {
  id         BigInt   @id @default(autoincrement())
  email      String   @db.VarChar(255)
  user_id    BigInt
  code       String   @db.VarChar(6)
  attempts   Int
  created_at DateTime @default(now()) @db.Timestamptz(3)
  due_until  DateTime @default(dbgenerated("now() + interval '5 minutes' "))

  email_code_user_reference User @relation("email_codes_user_reference", fields: [user_id], references: [id], onDelete: Cascade)

  @@map("email_codes")
}

model Chat {
  id         BigInt   @id @default(autoincrement())
  created_at DateTime @default(now()) @db.Timestamptz(3)

  chat_chat_user_reference    Chat_user[]
  chat_chat_message_reference Chat_message[]

  @@map("chats")
}

model Chat_user {
  id         BigInt   @id @default(autoincrement())
  user_id    BigInt
  chat_id    BigInt
  created_at DateTime @default(now()) @db.Timestamptz(3)

  chat_user_user_reference User @relation(fields: [user_id], references: [id], onDelete: Cascade)
  chat_user_chat_reference Chat @relation(fields: [chat_id], references: [id], onDelete: Cascade)

  @@map("chat_users")
}

model Chat_message {
  id         BigInt   @id @default(autoincrement())
  user_id    BigInt
  chat_id    BigInt
  msg        String   @db.VarChar(500)
  created_at DateTime @default(now()) @db.Timestamptz(3)

  chat_message_user_reference User @relation(fields: [user_id], references: [id], onDelete: Cascade)
  chat_message_chat_reference Chat @relation(fields: [chat_id], references: [id], onDelete: Cascade)

  @@map("chat_messages")
}

enum RelationType {
  FRIEND
  BLOCKED
}

model Friend_request {
  id         BigInt   @id @default(autoincrement())
  owner_id   BigInt
  target_id  BigInt
  created_at DateTime @default(now()) @db.Timestamptz(3)

  @@map("friend_requests")
}

model Relation {
  id         BigInt       @id @default(autoincrement())
  sender_id  BigInt
  target_id  BigInt
  relation   RelationType
  created_at DateTime     @default(now()) @db.Timestamptz(3)

  relation_sender_reference User @relation("relation_sender_id_reference", fields: [sender_id], references: [id])
  relation_target_reference User @relation("relation_target_id_reference", fields: [target_id], references: [id])

  @@unique([sender_id, target_id])
  @@map("relations")
}
