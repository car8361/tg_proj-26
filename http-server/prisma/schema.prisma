// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       BigInt @id @default(autoincrement())
  email    String @unique @db.VarChar(255)
  username String @unique @db.VarChar(64)
  password String @db.VarChar(255)

  email_codes   Email_code[]   @relation("email_codes_user")
  friends_user1 Relation[]     @relation("friends_user1")
  friends_user2 Relation[]     @relation("friends_user2")
  chatUsers     Chat_user[]
  chatMessages  Chat_message[]

  @@map("users")
}

model Email_code {
  id         BigInt   @id @default(autoincrement())
  email      String   @db.VarChar(255)
  user_id    BigInt
  code       String   @db.VarChar(6)
  attempts   Int
  created_at DateTime @default(now()) @db.Timestamptz(3)
  due_until  DateTime @default(dbgenerated("now() + interval '5 minutes' "))

  user User @relation("email_codes_user", fields: [user_id], references: [id], onDelete: Cascade)

  @@map("email_codes")
}

model Chat {
  id         BigInt   @id @default(autoincrement())
  created_at DateTime @default(now()) @db.Timestamptz(3)

  chatUsers    Chat_user[]
  chatMessages Chat_message[]

  @@map("chats")
}

model Chat_user {
  id         BigInt   @id @default(autoincrement())
  user_id    BigInt
  chat_id    BigInt
  created_at DateTime @default(now()) @db.Timestamptz(3)

  chat_user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
  chat      Chat @relation(fields: [chat_id], references: [id], onDelete: Cascade)

  @@map("chat_users")
}

model Chat_message {
  id         BigInt   @id @default(autoincrement())
  user_id    BigInt
  chat_id    BigInt
  msg        String   @db.VarChar(500)
  created_at DateTime @default(now()) @db.Timestamptz(3)

  message_owner  User @relation(fields: [user_id], references: [id], onDelete: Cascade)
  chat_reference Chat @relation(fields: [chat_id], references: [id], onDelete: Cascade)

  @@map("chat_messages")
}

enum RelationType {
  FRIEND
  BLOCKED
}

model Friend_request {
  id         BigInt   @id @default(autoincrement())
  owner_id   BigInt
  target_id  BigInt
  created_at DateTime @default(now()) @db.Timestamptz(3)

  @@map("friend_requests")
}

model Relation {
  id         BigInt       @id @default(autoincrement())
  owner_id   BigInt
  target_id  BigInt
  relation   RelationType
  created_at DateTime     @default(now()) @db.Timestamptz(3)

  user1 User @relation("friends_user1", fields: [owner_id], references: [id])
  user2 User @relation("friends_user2", fields: [target_id], references: [id])

  @@unique([owner_id, target_id])
  @@map("relations")
}
