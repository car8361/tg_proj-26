// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       BigInt @id @default(autoincrement())
  email    String @unique
  username String @unique
  password String

  email_codes   Email_code[] @relation("email_codes_user")
  friends_user1 Friend[]     @relation("friends_user1")
  friends_user2 Friend[]     @relation("friends_user2")

  @@map("users")
}

model Email_code {
  id         BigInt   @id @default(autoincrement())
  email      String
  user_id    BigInt
  code       String
  attempts   Int
  created_at DateTime @default(now()) @db.Timestamptz(3)
  due_until  DateTime @default(dbgenerated("now() + interval '5 minutes' "))

  user User @relation("email_codes_user", fields: [user_id], references: [id], onDelete: Cascade)

  @@map("email_codes")
}

model Chat {
  id         BigInt   @id @default(autoincrement())
  created_at DateTime @default(now()) @db.Timestamptz(3)

  chatUsers Chat_user[]

  @@map("chats")
}

model Chat_user {
  id         BigInt   @id @default(autoincrement())
  chat_id    BigInt
  created_at DateTime @default(now()) @db.Timestamptz(3)

  chat Chat @relation(fields: [chat_id], references: [id], onDelete: Cascade)

  @@map("chat_users")
}

model Friend_request {
  id          BigInt   @id @default(autoincrement())
  sender_id   BigInt
  receiver_id BigInt
  created_at  DateTime @default(now()) @db.Timestamptz(3)

  @@map("friend_requests")
}

model Friend {
  id       BigInt @id @default(autoincrement())
  user1_id BigInt
  user2_id BigInt

  user1 User @relation("friends_user1", fields: [user1_id], references: [id])
  user2 User @relation("friends_user2", fields: [user2_id], references: [id])

  @@unique([user1_id, user2_id])
  @@map("friends")
}
